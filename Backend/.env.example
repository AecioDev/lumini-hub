# Ambiente de execução. O que cada valor faz:
#   development -> log do banco COMPLETO: mostra todo SQL com os valores (inclusive o hash
#                  de senha de quem faz login). Só para a sua máquina, para depurar.
#   staging     -> log do banco enxuto (só erros e consultas lentas, sem valores). Cookies de
#                  login SEM o atributo Secure: serve para acesso por HTTP (servidor de testes por IP).
#   production  -> mesmo log enxuto do staging, mas com cookies de login Secure: EXIGE HTTPS.
#   (em branco, não definido ou qualquer outro valor) -> log enxuto como no staging e cookies
#                  sem Secure. Esquecer esta variável nunca liga o log verboso.
# Para ver o SQL no log enquanto desenvolve, deixe APP_ENV=development.
APP_ENV=development
SERVER_PORT=4000
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10
SERVER_IDLE_TIMEOUT=60

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=erp_system
DB_SSLMODE=disable
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/erp_system?sslmode=disable

# Liga/desliga o AutoMigrate dos serviços ao subir (true/false). Ligado por padrão
# pra um banco vazio subir sozinho; em produção com dados reais, desligar (false).
DB_AUTO_MIGRATE=true

# Primeiro usuário ADMIN, criado só no primeiro boot (banco sem usuários).
# Sem BOOTSTRAP_ADMIN_PASSWORD o admin NÃO é criado (não existe senha default).
# A senha precisa ter de 8 a 72 caracteres (use uma forte: este é o perfil ADMIN) e
# só é lida no primeiro boot — depois dele, REMOVA-A deste arquivo/ambiente.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=

JWT_SECRET=lumini-hub-super-secret-key-change-in-production
JWT_ACCESS_EXP=15
JWT_REFRESH_EXP=10080

# Chave AES-256 (hex, 64 caracteres) usada pra criptografar dados sensíveis
# reversíveis (ex.: senha de certificado digital A1) — gerar com:
# openssl rand -hex 32
CERTIFICATE_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# Banco SÓ pra testes automatizados (go test). O nome do banco PRECISA terminar em
# "_test": o teste recusa qualquer outro, pra nunca rodar no banco de desenvolvimento.
# Cada teste usa um schema descartável dentro dele. Sem esta variável, os testes que
# precisam de Postgres são pulados. Crie o banco antes: CREATE DATABASE lumini_test;
# TEST_DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/lumini_test?sslmode=disable
