APP_ENV=development
SERVER_PORT=4000
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10
SERVER_IDLE_TIMEOUT=60

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=erp_system
DB_SSLMODE=disable
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/erp_system?sslmode=disable

JWT_SECRET=lumini-hub-super-secret-key-change-in-production
JWT_ACCESS_EXP=15
JWT_REFRESH_EXP=10080

# SQL Server Configuration (FOCCO_ERP)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=your_sqlserver_password
MSSQL_NAME=FOCCO_ERP
