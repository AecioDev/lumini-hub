# Build único para qualquer microsserviço Go: docker build --build-arg SERVICE=api.core ...
FROM golang:1.26-alpine AS build
ARG SERVICE
WORKDIR /src
COPY Backend/ ./
RUN test -n "$SERVICE" && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/app lumini-hub/${SERVICE}

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 10001 app
USER app
WORKDIR /app
COPY --from=build /out/app /app/app
ENTRYPOINT ["/app/app"]
