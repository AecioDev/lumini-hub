# Copie para deploy/.env na VM e preencha. NUNCA commitar o .env real.
# "staging" porque cookies Secure (APP_ENV=production) não funcionam em HTTP puro.
# Ao ligar HTTPS com domínio, troque para production.
APP_ENV=staging

DB_USER=postgres
DB_PASSWORD=            # openssl rand -hex 16
DB_NAME=erp_system

JWT_SECRET=             # openssl rand -hex 32
CERTIFICATE_ENCRYPTION_KEY=   # openssl rand -hex 32

# Banco vazio sobe sozinho (tabelas, perfil ADMIN, permissões e menu). Desligar (false) só em
# produção com dados reais: aí nada é migrado nem semeado e o operador assume schema e dados.
DB_AUTO_MIGRATE=true

# Primeiro usuário ADMIN. Só é criado no 1º boot e só se a senha estiver definida (8 a 72
# caracteres, use uma forte). REMOVA BOOTSTRAP_ADMIN_PASSWORD deste arquivo depois do 1º boot.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=     # openssl rand -base64 18
BOOTSTRAP_ADMIN_EMAIL=

# Endereço servido pelo Caddy e origin liberado no CORS do gateway
SITE_ADDRESS=:80
CORS_ALLOWED_ORIGINS=http://64.181.183.243

# Só se for subir o profile "integrations"
MSSQL_HOST=
MSSQL_USER=
MSSQL_PASSWORD=
